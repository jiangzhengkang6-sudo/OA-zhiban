# Run from backend/. Copy into backend/.env for local development.
ENVIRONMENT=development
AUTH_PROVIDER=mock
OA_PROVIDER=mock
OA_BASE_URL=
OA_API_KEY=
OA_TIMEOUT_SECONDS=10
OA_READ_RETRIES=2
# Text: set deepseek after supplying both keys and an enabled Doubao model/endpoint.
LLM_PROVIDER=mock
LLM_FALLBACK_PROVIDER=ark
LLM_TIMEOUT_SECONDS=10
MEETING_LLM_TIMEOUT_SECONDS=45
# TUIRoomKit Web integration is available; configure these server-side credentials to enable it.
# Use the SDKAppID and SDKSecretKey from the same Tencent RTC application.
# Keep SDKSecretKey in backend/.env only; never use a VITE_ variable for it.
TRTC_SDK_APP_ID=0
TRTC_SDK_SECRET_KEY=
TRTC_USER_SIG_EXPIRE_SECONDS=3600
TRTC_ADMIN_USER_ID=administrator
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_CHAT_MODEL=deepseek-flash
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=
ARK_CHAT_MODEL=
# Use disabled for supported Doubao models when low latency is required; default omits the field.
ARK_THINKING_TYPE=default
# Embeddings are independent; changing models requires rebuilding the index.
EMBEDDING_PROVIDER=mock
EMBEDDING_DIM=1536
ARK_EMBEDDING_MODEL=doubao-embedding-large
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_SECONDS=30
DATABASE_URL=postgresql+asyncpg://oa:oa@localhost:5433/oa_agent
DATABASE_SYNC_URL=postgresql+psycopg://oa:oa@localhost:5433/oa_agent
CHECKPOINTER_URL=postgresql://oa:oa@localhost:5433/oa_agent
# Never enable this switch for development or production.
ALLOW_TEST_DATABASE_RESET=false
# Integration tests override all three URLs with *_test and need an explicit
# ALLOW_TEST_DATABASE_RESET=true in their process environment.
# 附件目录为私有目录，不挂静态文件路由；未配置扫描服务时状态为 PENDING。
ATTACHMENT_STORAGE_DIR=data/leave_attachments
ATTACHMENT_MAX_BYTES=10485760
CLAMD_HOST=
CLAMD_PORT=3310
ATTACHMENT_SCAN_TIMEOUT_SECONDS=10

# Independent monitor. These switches do not start a process or send notifications.
OPS_STATE_DIR=data/operations-monitor
OPS_HEALTH_URL=http://127.0.0.1:8015/healthz
OPS_POLL_SECONDS=60
OPS_PROBE_TIMEOUT_SECONDS=10
OPS_BACKLOG_AGE_SECONDS=120
OPS_BACKUP_MAX_AGE_HOURS=25
OPS_BACKUP_MAX_RUNTIME_SECONDS=3600
# Active model probes consume a small amount of provider usage every cycle.
OPS_MODEL_PROBES_ENABLED=false
OPS_ALERT_DELIVERY_ENABLED=false
OPS_ALERT_EMAIL_TO=
# Explicit absolute UTF-8 log paths; JSON arrays, no wildcards.
OPS_LOG_FILES=[]
OPS_LOG_KEYWORDS=["ERROR","CRITICAL","Traceback"]

# Shared office mailbox. IMAP credentials fall back to existing SMTP credentials.
# External delivery is independent of business escalation. Enable deliberately.
NOTIFICATION_WECOM_WORKER_ENABLED=false
NOTIFICATION_SMTP_WORKER_ENABLED=false
BUSINESS_SCHEDULER_ENABLED=true
WECOM_ENABLED=false
WECOM_WEBHOOK_URL=
WECOM_TENANT_ID=
WECOM_DEPARTMENT_ID=
# Set once to a timezone-aware cutover timestamp BEFORE enabling group delivery.
# Missing cutover fails closed. Do not backdate it or reset it at every restart.
# WECOM_POLICY_ACTIVATED_AT=2026-10-26T12:00:00+08:00
WECOM_GROUP_INTERVAL_SECONDS=60
WECOM_NUDGE_INTERVAL_SECONDS=7200
# Enable only after configuring SMTP_ENABLED/HOST/PORT/USERNAME/PASSWORD/FROM.
# SMTP port 465 uses TLS; other ports require SMTP_STARTTLS=true.
PUBLIC_MAILBOX_ENABLED=false
PUBLIC_MAILBOX_NAME=综合办公公共邮箱
IMAP_HOST=imap.qq.com
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_TIMEOUT_SECONDS=20

# Tencent video meeting signing credentials. Fill real values in private .env only.
TRTC_SDK_APP_ID=0
TRTC_SDK_SECRET_KEY=
TRTC_USER_SIG_EXPIRE_SECONDS=3600
TRTC_ADMIN_USER_ID=administrator

# Optional Tencent TRTC 2.0 ASR. Keep disabled until cloud activation and HTTPS callback are ready.
# Cloud API credentials differ from TRTC_SDK_SECRET_KEY. Fill real values in private .env only.
MEETING_TRANSCRIPTION_ENABLED=false
MEETING_TRANSCRIPTION_SECRET_ID=
MEETING_TRANSCRIPTION_SECRET_KEY=
MEETING_TRANSCRIPTION_CALLBACK_KEY=
MEETING_TRANSCRIPTION_CALLBACK_URL=
MEETING_TRANSCRIPTION_REGION=ap-guangzhou
MEETING_TRANSCRIPTION_LANGUAGE=bigmodel-zh
MEETING_TRANSCRIPTION_RETENTION_DAYS=30
