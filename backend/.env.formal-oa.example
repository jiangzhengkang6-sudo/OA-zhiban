# Merge into backend/.env; preserve existing model/SMTP credentials.
# Local standalone OA, not an external test bridge or production deployment.
ENVIRONMENT=development
AUTH_PROVIDER=builtin
AUTH_TENANT_ID=local
# Generate a unique random key of at least 32 bytes; never commit the real key.
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=oa-local
AUTH_JWT_AUDIENCE=oa-browser
AUTH_ALLOWED_ORIGINS=["http://127.0.0.1:5182","http://localhost:5182"]
# HTTP loopback only; production requires HTTPS and true.
AUTH_COOKIE_SECURE=false
OA_PROVIDER=builtin
# builtin does not use OA_BASE_URL or OA_API_KEY.
ALLOW_TEST_DATABASE_RESET=false
NOTIFICATION_APP_URL=http://127.0.0.1:5182/oa/notifications
# Keep existing SMTP, model and embedding settings.
# Notification recipients belong to database user contacts, not this file.

# WeCom group robot. Put the real URL only in private backend/.env.
WECOM_ENABLED=false
WECOM_WEBHOOK_URL=
WECOM_TENANT_ID=local
# Internal department ID from organization management, not its display name.
WECOM_DEPARTMENT_ID=
WECOM_TIMEOUT_SECONDS=10

# Optional ClamAV for the host-run backend. Configure only after the scanner
# has loaded its signatures and passed verify_attachment_scanner.py.
CLAMD_HOST=
CLAMD_PORT=3310
ATTACHMENT_SCAN_TIMEOUT_SECONDS=10
# Scanner connection failures block attachment submission (fail closed).
