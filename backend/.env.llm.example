# Merge these entries into backend/.env for a local backend, or root .env for Compose.
# Preserve existing database, OA and auth entries. Never commit real keys.
LLM_PROVIDER=deepseek
LLM_FALLBACK_PROVIDER=ark
LLM_TIMEOUT_SECONDS=10
MEETING_LLM_TIMEOUT_SECONDS=45
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_CHAT_MODEL=deepseek-flash
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=
# Required: your enabled Doubao model ID or ep-... supporting JSON and tools.
ARK_CHAT_MODEL=
# Use disabled for supported Doubao models when low latency is required; default omits the field.
ARK_THINKING_TYPE=default
EMBEDDING_PROVIDER=mock
# For doubao-embedding-vision, use the multimodal endpoint and a supported dimension.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_DIM=1536
ARK_EMBEDDING_MODEL=doubao-embedding-large
