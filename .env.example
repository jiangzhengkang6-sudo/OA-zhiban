# OA 智能体系统 MVP - 环境变量样例
# 复制为 .env 后按需修改。默认值已可配合 docker-compose 与 Mock 模式开箱即用。

# ---- 数据库（默认对接 docker-compose 的 PostgreSQL + pgvector）----
AI_ENABLED=true
# false 时关闭智能入口和图运行期，正式人工 OA 与组织管理仍可使用。
DATABASE_URL=postgresql+asyncpg://oa:oa@localhost:5433/oa_agent
DATABASE_SYNC_URL=postgresql+psycopg://oa:oa@localhost:5433/oa_agent

# ---- 向量维度（Mock 用确定性向量，真实 ARK 以模型维度为准）----
EMBEDDING_DIM=1536

# ---- 文本模型：mock | deepseek | ark ----
# 本地预览保持 mock；启用真实模型前填写双方 Key 和 ARK_CHAT_MODEL。
LLM_PROVIDER=mock
LLM_FALLBACK_PROVIDER=ark
LLM_TIMEOUT_SECONDS=10
MEETING_LLM_TIMEOUT_SECONDS=45
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_CHAT_MODEL=deepseek-flash
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=
ARK_CHAT_MODEL=
ARK_THINKING_TYPE=default
# 向量与文本独立；更换向量模型须重建知识库索引。
EMBEDDING_PROVIDER=mock
ARK_EMBEDDING_MODEL=doubao-embedding-large
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_SECONDS=30

# ---- OA 提供方：mock | real ----
OA_PROVIDER=mock
AUTH_PROVIDER=mock
ENVIRONMENT=development
ALLOW_TEST_DATABASE_RESET=false
CHECKPOINTER_URL=postgresql://oa:oa@localhost:5433/oa_agent
MOCK_STATE_FILE=data/mock_state.json

# ---- 默认阈值（可被 agent_policy 覆盖）----
INTENT_CONFIDENCE_THRESHOLD=0.6
FAQ_ANSWER_THRESHOLD=0.65
NUDGE_AFTER_SECONDS=300
ESCALATE_AFTER_SECONDS=900
SCHEDULER_INTERVAL_SECONDS=10
# Local accounts: configure privately in backend/.env; never put real secrets here.
# AUTH_PROVIDER=builtin
# AUTH_TENANT_ID=local
# AUTH_JWT_SECRET=
# AUTH_COOKIE_SECURE=true
# AUTH_ALLOWED_ORIGINS=["https://oa.example.internal"]

# Independent operations monitor; Compose uses the optional monitoring profile.
OPS_POLL_SECONDS=60
OPS_PROBE_TIMEOUT_SECONDS=10
OPS_BACKLOG_AGE_SECONDS=120
OPS_BACKUP_MAX_AGE_HOURS=25
OPS_BACKUP_MAX_RUNTIME_SECONDS=3600
OPS_MODEL_PROBES_ENABLED=false
OPS_ALERT_DELIVERY_ENABLED=false
OPS_ALERT_EMAIL_TO=
# Explicit absolute UTF-8 log paths; JSON arrays, no wildcards.
OPS_LOG_FILES=[]
OPS_LOG_KEYWORDS=["ERROR","CRITICAL","Traceback"]

# Tencent video and optional TRTC 2.0 ASR. Real credentials belong in private .env only.
TRTC_SDK_APP_ID=0
TRTC_SDK_SECRET_KEY=
TRTC_USER_SIG_EXPIRE_SECONDS=3600
TRTC_ADMIN_USER_ID=administrator
MEETING_TRANSCRIPTION_ENABLED=false
MEETING_TRANSCRIPTION_SECRET_ID=
MEETING_TRANSCRIPTION_SECRET_KEY=
MEETING_TRANSCRIPTION_CALLBACK_KEY=
MEETING_TRANSCRIPTION_CALLBACK_URL=
MEETING_TRANSCRIPTION_REGION=ap-guangzhou
MEETING_TRANSCRIPTION_LANGUAGE=bigmodel-zh
MEETING_TRANSCRIPTION_RETENTION_DAYS=30
